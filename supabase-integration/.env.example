# ─────────────────────────────────────────────────────────────────────────
# PUBLIC — safe to ship in the frontend bundle.
# These are protected by Row Level Security, not by secrecy. Anyone can read
# them out of the deployed JavaScript; that is expected and fine.
# ─────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://dkkpolnuywgvmlacjzto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your publishable / anon key>

# Optional. Stamped onto error reports and analytics events so you can tell
# which build a crash came from. Vercel exposes the commit SHA already:
#   VITE_APP_VERSION=$VERCEL_GIT_COMMIT_SHA
VITE_APP_VERSION=dev

# Optional kill switches. Set either to "off" to stop that data being written
# — useful in local development, where every hot reload would otherwise log.
# VITE_ERROR_REPORTING=off
# VITE_ANALYTICS=off

# Optional. The PUBLIC half of a VAPID key pair, which is what lets a browser
# subscribe to push notifications. Without it the push toggle in profile
# settings reports "not available on this deployment" rather than failing.
# Generate a pair with:  npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────────────────
# SECRET — server-side only. Set these as Supabase secrets for Edge
# Functions (`supabase secrets set NAME=value`), NEVER in this file with a
# VITE_ prefix and never anywhere the browser can reach.
#
# Anything with a VITE_ prefix is compiled into the public bundle. That is
# the whole reason the split exists: adding VITE_ to any name below would
# publish that secret to every visitor.
# ─────────────────────────────────────────────────────────────────────────

# Bypasses RLS entirely. Project Settings → API → service_role.
# SUPABASE_SERVICE_ROLE_KEY=

# Payments (see edge-functions/razorpay-*)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Notification delivery (see edge-functions/notify-dispatch)
# SITE_URL=https://your-domain
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL=MatchDay <noreply@your-domain>
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_ID=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@your-domain
